---
import '@/styles/global.css';
import { BOOT_STORAGE_KEY } from '@/data/site';
import { routes, t, type Lang } from '@/i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
}

const { lang } = Astro.props;
const meta = t(lang).meta;
const title = Astro.props.title ?? meta.title;
const description = Astro.props.description ?? meta.description;
const alternates = Object.entries(routes) as [Lang, string][];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#e6e8eb" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Versiones por idioma (SEO) -->
    <!-- Define `site` en astro.config.mjs (tu dominio) para que estas URLs sean absolutas -->
    {alternates.map(([code, path]) => <link rel="alternate" hreflang={code} href={Astro.site ? new URL(path, Astro.site).href : path} />)}
    <link rel="alternate" hreflang="x-default" href={Astro.site ? new URL(routes.es, Astro.site).href : routes.es} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'es' ? 'es_CO' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Geist (texto) y Fira Code (código) desde Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@300..700&family=Geist:wght@100..900&display=swap"
    />

    <!--
      Si en esta sesión ya se vio la intro, se marca <html class="booted">
      antes del primer pintado para que no parpadee al recargar o cambiar de idioma.
    -->
    <script is:inline define:vars={{ key: BOOT_STORAGE_KEY }}>
      try {
        if (sessionStorage.getItem(key)) document.documentElement.classList.add('booted');
      } catch (e) {}
    </script>
    <noscript>
      <style>
        .boot { display: none !important; }
        html { overflow: auto !important; }
      </style>
    </noscript>
  </head>
  <body data-world="canvas">
    <slot />
  </body>
</html>
